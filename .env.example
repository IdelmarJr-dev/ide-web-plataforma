# Variáveis usadas pelo docker-compose.yml (raiz do monorepo).
# Copie para `.env` e ajuste os valores — nunca commitar o `.env` real.

DB_PASSWORD=change-me
JWT_SECRET=change-me
LLM_API_KEY=

# Banco separado do sandbox SQL (dev local — ver docs/decisions/fase2-sandbox-sql-diagrama-mer.md
# e fase12-sql-studio-bd2.md, D13/D14).
# SANDBOX_DB_PASSWORD: senha da role de provisionamento (ide_sandbox_admin, dona do banco no container).
# SANDBOX_EXEC_DB_PASSWORD: senha da role de LOGIN da conexão de execução (sandbox_login,
# criada por scripts/sandbox-init.sh — sem privilégio próprio, só autentica e faz SET ROLE).
SANDBOX_DB_PASSWORD=change-me
SANDBOX_EXEC_DB_PASSWORD=change-me

# URL da API acessada pelo navegador — vira build-arg do frontend (Vite bake em build-time)
VITE_API_URL=http://localhost:3000/api/v1
