NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

DATABASE_URL="postgresql://ide_app:changeme@localhost:5432/ide_web?schema=public"

JWT_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Segredo compartilhado só com o backend Python de pesquisa (self-hosted, fora do
# Render) — ver docs/decisions/fase4-pesquisa-python-sessao-aluno-login.md. Nunca
# enviado ao navegador; assina o token curto que o front usa como Bearer nas
# chamadas diretas ao Python.
RESEARCH_JWT_SECRET=change-me
RESEARCH_JWT_EXPIRES_IN=30m

# Dicas de IA (ver docs/decisions/fase3-dicas-ia.md) — provedor Groq, API compatível
# com o SDK da OpenAI, free tier. LLM_API_KEY é opcional só até o momento em que o
# aluno pede a primeira dica: sem ela, a rota /exercicios/:id/dicas retorna 503.
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# Banco do sandbox SQL — projeto Supabase separado do banco principal em produção
# (ver docs/decisions/fase2-sandbox-sql-diagrama-mer.md). Localmente, aponta pro
# serviço db_sandbox do docker-compose.yml.
# SANDBOX_DATABASE_URL: role de provisionamento (cria/derruba schema, roda sql_setup,
# cria a role de execução exec_<usuario_id> de cada aluno — precisa de CREATEROLE
# em produção, ver "Setup manual pendente" no CLAUDE.md).
# SANDBOX_EXEC_DATABASE_URL: role de LOGIN mínima (sandbox_login — Fase 12, D14), sem
# privilégio próprio; a cada execução faz SET ROLE pra assumir a identidade exec_<id>
# do aluno da vez. Nunca usar a mesma role/connection do provisionamento aqui.
SANDBOX_DATABASE_URL="postgresql://ide_sandbox_admin:changeme@localhost:5433/ide_sandbox?schema=public"
SANDBOX_EXEC_DATABASE_URL="postgresql://sandbox_login:changeme@localhost:5433/ide_sandbox?schema=public"
SANDBOX_STATEMENT_TIMEOUT_MS=5000
